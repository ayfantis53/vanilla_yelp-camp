<!-- APPLY COMMON LAYOUT -->
<% layout('layouts/boilerplate') %>

<div mb-4>
    <h1> <i class="fab fa-free-code-camp"></i> All Campgrounds </h1> 
    <hr>
    <!-- MAP DISPLAY -->
    <div id="cluster-map" class="col-md-9" style="height: 400px; margin: auto;"></div>
    <!-- ADD NEW CAMPGROUND BUTTON -->
    <button type="button" class="btn btn-secondary mt-2 mb-3 position-relative" data-bs-toggle="modal" data-bs-target="#newCamp"> Add New Campground </button>
    <!-- CAMPGROUNDS LIST -->
    <ul>
        <% for (let campground of campgrounds) { %>
            <div class="card mt-3 col-md-9" id="card_index">
                <!-- CAMPGROUND TITLE -->
                <h5 class="card-header"><i class="fas fa-campground fa-lg mx-2"></i> -- <%= campground.title %> -- </h5>
                 <!-- CAMPGROUND CARD -->
                <div class="card-body d-flex flex-row" style="background-image: linear-gradient( white, gray);">
                    <!-- CAMPGROUND IMAGE -->
                    <div class="col-md-2">
                        <!-- ARRAY ALWAYS HAS 1 ITEM IN IT, SO IF IMAGE ARRAY IS 1 OR LESS SET DEFAULT PIC -->
                        <% if (campground.images.length > 1) { %>
                            <img src="<%= campground.images[0].url %>" class="d-block w-100" alt="...">
                        <% } else { %>
                            <img src="../assets/default.png" class="d-block w-100" alt="...">
                        <% } %> 
                    </div>

                    <!-- CAMPGROUND INFO -->
                    <div class="col-mg-8 ms-3 d-flex flex-column">
                        <!-- CAMPGROUND LOCATION -->
                        <h5 class="card-title">- <%= campground.location %></h5>
                        <!-- CAMPGROUND DESCRIPTION -->
                        <p class="card-text"><%= campground.description %></p>
                        <!-- VIEW CAMPGROUND LINK -->
                        <a href="/campgrounds/<%= campground.id %>" class="btn btn-primary mt-auto align-self-end" style="width: 10rem"> View Campground </a>
                    </div> 
                </div>
            </div>
            <hr>
        <% } %>  
    </ul>

    <!-- MODAL NEW CAMPGROUND -->
    <div class="modal fade" id="newCamp" tabindex="-1" aria-labelledby="ModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
             <div class="modal-content">
                <!-- MODAL HEADER -->
                <div class="modal-header bg-secondary text-white">
                    <!-- MODAL TITLE -->
                    <h5 class="modal-title" id="ModalLabel"> New Campground </h5>
                    <!-- CLOSE BUTTON -->
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <!-- MODAL BODY -->
                <div class="modal-body">
                    <!-- CAMPGROUND FORM -->
                    <form action="/campgrounds" id="my-form" method="POST" novalidate class="validated-form" enctype="multipart/form-data">
                        <!-- CAMPGROUND TITLE -->
                        <div class="mb-2">
                            <label for="title" class="col-form-label"> Title: </label>
                            <input type="text" class="form-control" id="title" name="campground[title]" required>
                            <div class="valid-feedback"> Looks Good! </div>
                        </div>

                        <!-- CAMPGROUND LOCATION -->
                        <div class="mb-2">
                            <label for="location" class="col-form-label"> Location: </label>
                            <input type="text" class="form-control" id="location" name="campground[location]" required>
                            <div class="valid-feedback"> Looks Good! </div>
                        </div>

                        <!-- CAMPGROUND IMAGES -->
                        <div class="mb-2">
                            <label for="imgUrl" class="col-form-label"> Image Url: </label>
                            <input type="file" class="form-control" id="imgUrl" name="image" multiple>
                            <div class="valid-feedback"> Looks Good! </div>
                        </div>

                        <!-- CAMPGROUND PRICE -->
                        <div class="mb-2">
                            <label for="price" class="col-form-label"> Price: </label>
                            <div class="input-group mb-2">
                                <span class="input-group-text"> $ </span>
                                <input type="text" id="price" class="form-control" aria-label="Price" name="campground[price]" required>
                                <span class="input-group-text">.00 </span>
                            </div>
                            <div class="valid-feedback"> Looks Good! </div>
                        </div>

                        <!-- CAMPGROUND DESCRIPTION -->
                        <div class="mb-2">
                            <label for="description" class="col-form-label"> Description: </label>
                            <textarea type="text" class="form-control" id="description" name="campground[description]" cols="30" rows="3" required></textarea>
                            <div class="valid-feedback"> Looks Good! </div>
                        </div>
                    </form>
                </div>

                <!-- ADD CAMPGROUND BUTTON -->
                <div class="modal-footer bg-secondary">
                    <button type="submit" class="btn btn-success" form="my-form"> Add Campground </button>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- MAPBOX CONFIG SETUP -->
<script>
	const mapToken    = '<%-process.env.MAPBOX_TOKEN%>';
    const campgrounds = { features: <%-JSON.stringify(campgrounds)%> };
</script>
<script src="/clusterMap.js"></script> 
