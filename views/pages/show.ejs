<!-- APPLY COMMON LAYOUT -->
<% layout('layouts/boilerplate') %>

<!-- OUR STYLES IMPORT CSS -->
<link rel="stylesheet" href="../stylesheets/stars.css">

<!-- TITLE -->
<h1><i class="fab fa-free-code-camp"></i> <%= campground.title %></i></h1> 
<hr>
<div id="show_page">
    <!-- CARD VIEW OF CAMPGROUND -->
    <div class="card col-md-4" id="show_card">
        <!-- IMAGE CAROUSEL -->
        <div id="carouselCampgrounds" class="carousel-slide" data-bs-ride="carousel" data-bs-interval="false">
            <!-- ALL PHOTOS IN CAROUSEL -->
            <div class="carousel-inner">
                <!-- ARRAY ALWAYS HAS 1 ITEM IN IT, SO IF IMAGE ARRAY IS 1 OR LESS SET DEFAULT PIC -->
                <% if (campground.images.length > 1) { %>
                    <% campground.images.forEach((img, i) => { %>
                        <div class="carousel-item <%= i === 0 ? 'active' : ''%> ">
                            <img src="<%= img.url %>" class="d-block w-100" alt="...">
                        </div>
                    <% }) %> 
                <% } else { %>  
                    <img src="../assets/default.png" class="img-fluid" alt="...">
                <% } %> 
            </div>
            
            <!-- IMAGE CAROUSEL CONTROL PREV/NEXT BUTTONS -->
            <% if (campground.images.length > 2) { %>
                <button class="carousel-control-prev" type="button" data-bs-target="#carouselCampgrounds" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden"> Previous </span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#carouselCampgrounds" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden"> Next </span>
            <% } %>
        </div>

        <!-- CARD INFO -->
        <div class="card-body">
            <!-- CAMPGROUND TITLE -->
            <h5 class="card-title"><i class="fas fa-campground me-2"></i> -- <%= campground.title %> -- </h5>
            <hr>
            <!-- CAMPGROUND DESCRIPTION -->
            <p class="card-text"><%= campground.description %></p>
        </div>

        <ul class="list-group list-group-flush">
            <!-- CAMPGROUND LOCATION -->
            <li class="list-group-item"><i class="fas fa-map-marker-alt"></i> <%= campground.location %> </li>
            <!-- CAMPGROUND PRICE -->
            <li class="list-group-item"><i class="fas fa-wallet"></i>  <small>$</small><b><%= campground.price %></b> / Night </li>
        </ul>

        <div class="card-body" style="background-image: linear-gradient( white, gray);">
            <!-- MODAL EDIT BUTTON IF LOGGIN USER IS AUTHOR OF REVIEW-->
            <% if (currentUser && campground.author.equals(currentUser._id)) { %> 
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newCamp">Edit <%= campground.title %></button>
            <% } %>
            <a class="btn btn-secondary" href="/campgrounds"> All Campgrounds </a>
        </div>

        <!-- LEAVE A REVIEW LINK ONLY IF USER LOGGED IN -->
        <div class="card-footer text-muted">
            Submitted by... <b><%= campground.author.username %></b> 
            <% if (currentUser) { %> 
                <a data-bs-toggle="modal" href="#leaveAReview" style="float: right;"> Leave a Review! </a>
            <% } %>
        </div>
    </div>

    <!-- REVIEWS -->
    <div class="col-md-5" id="show_review">
        <!-- MAP DISPLAY -->
        <div class='max-width: 100%' id='show_map'></div>

        <!-- REVIEWS STAR RATINGS -->
        <h3>
            <i class="far fa-star"></i><i class="far fa-star"></i><i class="far fa-star-half"></i>
                User Reviews
            <i class="far fa-star-half fa-flip-horizontal"></i><i class="far fa-star"></i><i class="far fa-star"></i>
        </h3>
        <hr>
        
        <!-- LIST OF REVIEWS -->
        <% for (let review of campground.reviews) { %>
            <div class="card">
                <div class="card-header d-flex flex-row">
                    <div class="md-2"> Review Rating: </div>

                    <p class="starability-result ms-1" data-rating= <%= review.rating %>>
                      Rated: <%= review.rating %> stars
                    </p>

                    <form action="/campgrounds/<%= campground._id%>/reviews/<%= review._id%>?_method=DELETE" class="ms-auto" method="POST">
                        <% if (currentUser && review.author.equals(currentUser._id)) { %> 
                            <button class="btn btn-sm btn-danger"> Delete </button>
                        <% } %>
                    </form>
                </div>

                <!-- REVIEW AUTHOR NAME -->
                <div class="card-body">
                    <blockquote class="blockquote mb-0">
                        <p> <%= review.body %> </p>
                        <footer class="blockquote-footer"> Written by... <cite title="Source Title"> <b><%= review.author.username %></b></cite></footer>
                    </blockquote>
                </div>
            </div>
        <% } %>  
    </div>  
</div>

<!-- MODAL EDIT CAMPGROUND -->
<div class="modal fade" id="newCamp" tabindex="-1" aria-labelledby="ModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <!-- MODAL HEADER -->
            <div class="modal-header bg-secondary text-white">
                <!-- MODAL TITLE -->
                <h5 class="modal-title" id="ModalLabel"> Edit Campground </h5>
                <!-- CLOSE BUTTON -->
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- MODAL BODY -->
            <div class="modal-body">
                <!-- CAMPGROUND FORM -->
                <form action="/campgrounds/<%= campground._id %>?_method=PUT" id="my-form" method="POST" novalidate class="validated-form" enctype="multipart/form-data">
                    <!-- CAMPGROUND TITLE -->
                    <div class="mb-2">
                        <label for="title" class="col-form-label"> Title: </label>
                        <input type="text" class="form-control" id="title" name="campground[title]" value="<%= campground.title %>" required>
                        <div class="valid-feedback"> Looks Good! </div>
                    </div>

                    <!-- CAMPGROUND LOCATION -->
                    <div class="mb-2">
                        <label for="location" class="col-form-label"> Location: </label>
                        <input type="text" class="form-control" id="location" name="campground[location]" value="<%= campground.location %>" required>
                        <div class="valid-feedback"> Looks Good! </div>
                    </div>

                    <!-- CAMPGROUND IMAGES -->
                    <div class="mb-2">
                        <label for="image" class="col-form-label"> Image Url: </label>
                        <input type="file" class="form-control" id="image" name="image" value="<%= campground.image %>" multiple>
                        <div class="valid-feedback"> Looks Good! </div>
                    </div>

                    <!-- DELETE IMAGES -->
                    <div class="mb-3">
                        <% campground.images.forEach(function(img,i) { %>
                            <img src="<%= img.thumbnail %>" alt="" class="img-thumbnail">
                            <div class="form-check-inline">
                                <input type="checkbox" id="image-<%= i %>" name="deleteImages[]" value="<%= img.filename %>">
                            </div>
                            <label for="image-<%= i %>"> Delete? </label>
                        <% }) %> 
                    </div>

                    <!-- CAMPGROUND PRICE -->
                    <div class="mb-2">
                        <label for="price" class="col-form-label"> Price: </label>
                        <div class="input-group mb-2">
                            <span class="input-group-text"> $ </span>
                            <input type="text" id="price" class="form-control" aria-label="Price" name="campground[price]" value="<%= campground.price %>" required>
                            <span class="input-group-text">.00 </span>
                        </div>
                        <div class="valid-feedback"> Looks Good! </div>
                    </div>

                    <!-- CAMPGROUND DESCRIPTION -->
                    <div class="mb-2">
                        <label for="description" class="col-form-label"> Description: </label>
                        <textarea type="text" class="form-control" id="description" name="campground[description]" cols="30" rows="3" required> <%= campground.description %> </textarea>
                        <div class="valid-feedback"> Looks Good! </div>
                    </div>
                </form>
            </div>

            <!-- EDIT CAMPGROUND BUTTON -->
            <div class="modal-footer bg-secondary">
                <form action="/campgrounds/<%= campground._id %>?_method=DELETE" method="POST">
                    <button class="btn btn-danger"> Delete </button>
                </form>
                <button type="submit" class="btn btn-success" form="my-form"> Edit Campground </button>
            </div>
        </div>
     </div>
</div>

<!-- MODAL LEAVE A REVIEW -->
<div class="modal fade" id="leaveAReview" tabindex="-1" aria-labelledby="ModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <!-- MODAL HEADER -->
            <div class="modal-header bg-light text-white">
                <!-- MODAL TITLE -->
                <h5 class="modal-title text-secondary" id="ModalLabel"> Leave A Review </h5>
                <!-- CLOSE BUTTON -->
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- MODAL BODY -->
            <div class="modal-body">
                <form action="/campgrounds/<%= campground._id %>/reviews" id="post-review" method="POST" novalidate class="validated-form">
                    <div>
                        <!-- USER SET RATING -->
                        <fieldset class="starability-basic">
                            <!-- RATING TEXT -->
                            <legend> Rating: </legend>
                            <!-- STARS INPUT -->
                            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1" title="Terrible"> 1 star </label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2" title="Not good"> 2 stars </label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                            <label for="first-rate3" title="Average"> 3 stars </label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4" title="Very good"> 4 stars </label>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                            <label for="first-rate5" title="Amazing"> 5 stars </label>
                        </fieldset>
                    </div>

                    <!-- REVIEW INPUT -->
                    <div>
                        <label class="form-label" for="body"><b> Review </b></label>
                        <textarea class="form-control" name="review[body]" id="body" cols="10" rows="5" required></textarea>
                        <div class="valid-feedback"> Looks Good! </div>
                    </div>
                </form>
            </div>

            <!-- SUBMIT REVIEW BUTTON -->
            <div class="modal-footer bg-light">
                <button type="submit" class="btn btn-primary" form="post-review"> Submit Review </button>
            </div>
        </div>
     </div>
</div>

<!--MAPBOX SCRIPT TO GET MAP TO SHOW-->
<script>
    const mapToken   = '<%-process.env.MAPBOX_TOKEN%>';
    const campground = <%-JSON.stringify(campground) %>;
</script>
<script src="/showPageMap.js"></script> 