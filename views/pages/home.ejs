<!DOCTYPE html>
<html lang="en">

<!-- CONTAINER FOR METADATA -->
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> YelpCamp </title>
    
    <!-- BOOTSTRAP5 IMPORT JS & CSS -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/5.0.0-alpha1/css/bootstrap.min.css" integrity="sha384-r4NyP46KrjDleawBgD5tp8Y7UzmLA05oM1iAEQ17CSuDqnUK2+k9luXQOfXJCJ4I" crossorigin="anonymous">
    <link rel="stylesheet" href="/stylesheets/home.css">
</head>

<!-- CONTAINER FOR MAIN CONTENT -->
<body class="d-flex text-center text-white bg-dark">
    <div class="cover-container d-flex w-100 h-100 p-3 mx-auto flex-column">
        <!-- INTRODUCTORY CONTENT -->
        <header class="mb-auto">
            <div>
                <!-- NAVIGATION BAR -->
                <nav class="nav nav-masthead">
                    <!-- HOME LINK -->
                    <a class="nav-link active" aria-current="page" href="#"> Home </a>
                    <!-- CAMPGROUNDS LINK -->
                    <a class="nav-link" href="/campgrounds"> Campgrounds </a>
                    <!-- LOGIN & REGISTER LINK OR LOGOUT LINK BASED ON USER COOKIE -->
                    <% if (!currentUser) { %>
                        <a class="nav-link" href="/login"> Login </a>
                        <a class="nav-link" href="/register"> Register </a>
                    <% } else { %>
                        <a class="nav-link" href="/logout"> Logout </a>
                    <% } %>
                </nav>
            </div>
        </header>

        <!-- MAIN BODY CONTENT -->
        <main class="px-3">
            <h1 class="mb-4"> YelpCamp </h1>

            <p class="lead mb-4"> Welcome to YelpCamp! <br> Jump right in and explore our many campgrounds. <br>
                Feel free to share some of your own and comment on others!</p>

            <a href="/campgrounds" class="btn btn-lg btn-secondary font-weight-bold border-white bg-white">View
                Campgrounds</a>
        </main>

        <!-- SUPPLEMENTARY DATA & METADATA CONTENT -->
        <footer class="mt-auto text-white-50">
            <p>&copy; 2026 </p>
        </footer>
    </div>

    <!-- BOOTSTRAP5 IMPORT JS & CSS -->
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js" integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo" crossorigin="anonymous"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/5.0.0-alpha1/js/bootstrap.min.js" integrity="sha384-oesi62hOLfzrys4LxRF63OJCXdXDipiYWBnvTl9Y9/TRlw5xlKIEHpNyvvDShgf/" crossorigin="anonymous"></script>
</body>

</html>