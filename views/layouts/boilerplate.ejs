<html lang="en">

<!-- CONTAINER FOR METADATA -->
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Yelp-Camp </title>

    <!-- FONT AWESOME IMPORT JS FOR ICONS -->
    <script src="https://kit.fontawesome.com/2c1ff8edcd.js" crossorigin="anonymous"></script>

    <!-- MAPBOX IMPORT JS & CSS -->
